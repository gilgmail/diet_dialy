{
  "name": "diet-daily",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest src/__tests__/integration --testTimeout=30000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:ci": "jest --runTestsByPath src/__tests__/ci/smoke.test.ts --runInBand",
    "lint:ci": "eslint src/app/layout.tsx src/components/common/OfflineIndicator.tsx src/components/google src/lib/google src/components/ui/button.tsx --max-warnings=0",
    "type-check:ci": "tsc --noEmit --project tsconfig.ci.json",
    "test:all": "npm run test && npm run test:e2e",
    "analyze": "ANALYZE=true next build",
    "perf:lighthouse": "npx lighthouse http://localhost:3000 --output=json --output=html --output-path=./reports/lighthouse",
    "perf:analyze": "npm run build:analyze && npm run perf:lighthouse",
    "ci:test": "npm run lint && npm run type-check && npm run test:coverage && npm run test:e2e",
    "deploy:staging": "npm run ci:test && npm run build && npm run deploy:staging:only",
    "deploy:production": "npm run ci:test && npm run build && npm run deploy:production:only",
    "deploy:staging:only": "echo 'Deploy to staging environment'",
    "deploy:production:only": "echo 'Deploy to production environment'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/uuid": "^10.0.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.2",
    "google-auth-library": "^10.3.0",
    "googleapis": "^159.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.438.0",
    "next": "^15.5.4",
    "next-pwa": "^5.6.0",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.4",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "undici": "^7.16.0",
    "web-streams-polyfill": "^4.2.0",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}

MAX_API_REQUESTS_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5

# 監控配置
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_ERROR_TRACKING=false
LOG_LEVEL=info

# 資料庫連接池配置 (針對 Pi 5 優化)

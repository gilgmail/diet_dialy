# Render Deployment Environment Example
# Copy these into Render as environment variables (via Dashboard or using Environment Groups).
# Do NOT commit real secrets.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-render-service.onrender.com
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application API base URL (used by mobile app clients)
EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com

# Authentication
NEXTAUTH_URL=https://your-render-service.onrender.com
NEXTAUTH_SECRET=replace-with-strong-random-secret

# Optional AI Integrations
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-haiku-20241022
CLAUDE_MAX_TOKENS=1000
CLAUDE_TEMPERATURE=0.3
OPENAI_API_KEY=your-openai-key
GOOGLE_VISION_API_KEY=your-google-vision-key

# Operational Settings
ENABLE_CACHE=true
CACHE_TTL=300
ENABLE_RATE_LIMITING=true
MAX_API_REQUESTS_PER_MINUTE=60

